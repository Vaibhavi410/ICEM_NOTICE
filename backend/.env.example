# ==============================================================================
# ICEM Smart Notice Portal - Backend Environment Configuration Template
# Copy this file to '.env' and fill in your local or production values.
# IMPORTANT: Never commit actual '.env' files or passwords to source control.
# ==============================================================================

# Server Environment & Port
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection String for Prisma
# Standard format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_DB_NAME?schema=public"

# JWT Authentication Secrets & Lifespans
JWT_SECRET="your_jwt_access_secret_key_here"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_here"
JWT_REFRESH_EXPIRES_IN="7d"

# Optional one-time SuperAdmin bootstrap. Set these only when running
# `npm run superadmin:bootstrap`, then remove them from the environment.
SUPERADMIN_BOOTSTRAP_USERNAME=""
SUPERADMIN_BOOTSTRAP_EMAIL=""
SUPERADMIN_BOOTSTRAP_FULL_NAME=""
SUPERADMIN_BOOTSTRAP_PASSWORD=""

# Allowed Frontend Client URLs for CORS (comma-separated without spaces)
CLIENT_URLS="http://localhost:5173,http://localhost:5174"

# Local File Upload Storage Directory & Limits (Legacy)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=15

# Supabase Storage Configuration (Private Notice Attachments)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="notice-attachments"

# Resend Email Configuration (for Newsletter Confirmations & Circular Alerts)
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend.
EMAIL_FROM=""
